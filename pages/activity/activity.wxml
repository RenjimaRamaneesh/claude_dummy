<!-- pages/activity/activity.wxml -->
<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="shade-gradient"></view>

  <!-- Header -->
  <view class="header">
    <text class="page-title">My Activity</text>
  </view>

  <!-- Content -->
  <scroll-view scroll-y class="content-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="empty-container">
      <image style="width:120rpx;height:120rpx" src="data:image/svg+xml;base64," mode="aspectFit"></image>
      <text class="empty-title">No activity yet</text>
      <text class="empty-subtitle">Your meal orders and activity will appear here</text>
    </view>
  </scroll-view>

  <!-- Bottom Navigation Bar -->
  <view class="bottom-nav">
    <view class="nav-item" bindtap="onNavTap" data-tab="home">
      <image style="width:44rpx;height:44rpx" src="data:image/svg+xml;base64," mode="aspectFit"></image>
      <text class="nav-label">Home</text>
    </view>
    <view class="nav-item" bindtap="onNavTap" data-tab="plan">
      <image style="width:44rpx;height:44rpx" src="data:image/svg+xml;base64," mode="aspectFit"></image>
      <text class="nav-label">My Plan</text>
    </view>
    <view class="nav-item active" bindtap="onNavTap" data-tab="activity">
      <image style="width:44rpx;height:44rpx" src="data:image/svg+xml;base64," mode="aspectFit"></image>
      <text class="nav-label active">My Activity</text>
    </view>
    <view class="home-indicator">
      <view class="indicator-bar"></view>
    </view>
  </view>
</view>
