.page-container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.status-bar {
  width: 100%;
  flex-shrink: 0;
}

.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.page-heading {
  font-weight: 700;
  font-size: 40rpx;
  color: #1E1E1E;
  margin-bottom: 16rpx;
}

.page-subtext {
  font-size: 28rpx;
  color: #757575;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 40rpx rgba(0, 0, 0, 0.2);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 100;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0 8rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.nav-label {
  font-weight: 700;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #757575;
}

.nav-label.active {
  color: #90CA14;
}
