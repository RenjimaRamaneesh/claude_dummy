/* pages/confirmation/confirmation.wxss */

/* ========== Page Container ========== */
.confirmation-page {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== Shade Gradient at Top ========== */
.shade {
  position: absolute;
  width: 100%;
  height: 200rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 40rpx;
  z-index: 0;
}

/* ========== Status Bar ========== */
.status-bar {
  width: 100%;
  position: relative;
  z-index: 1;
}

/* ========== Content ========== */
.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 690rpx;
  padding: 0 30rpx;
}

/* ========== Tick Circle ========== */
.tick-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 12rpx solid #90CA14;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.tick-mark {
  width: 120rpx;
  height: 80rpx;
  border-bottom: 20rpx solid #90CA14;
  border-left: 20rpx solid #90CA14;
  transform: rotate(-45deg);
  margin-top: -20rpx;
}

/* ========== Title ========== */
.title {
  font-weight: 600;
  font-size: 64rpx;
  line-height: 44rpx;
  text-align: center;
  color: #000000;
  margin-bottom: 36rpx;
}

/* ========== Description ========== */
.description {
  font-weight: 500;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
  color: #7C7C7C;
  width: 690rpx;
  margin-bottom: 60rpx;
}

/* ========== Back to Home Button ========== */
.home-btn {
  width: 684rpx;
  height: 96rpx;
  background: #90CA14;
  box-shadow: 4rpx 4rpx 40rpx rgba(0, 0, 0, 0.25);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-btn-text {
  font-weight: 600;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1E1E1E;
}

/* ========== Home Indicator ========== */
.home-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  padding-bottom: 16rpx;
  padding-top: 8rpx;
}

.indicator-bar {
  width: 288rpx;
  height: 10rpx;
  background: #000000;
  border-radius: 200rpx;
}
