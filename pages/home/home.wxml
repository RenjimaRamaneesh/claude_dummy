<!-- pages/home/home.wxml -->
<view class="page-container">
  <!-- Status Bar Spacer -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- Shade Gradient -->
  <view class="shade-gradient"></view>

  <!-- Fixed Header -->
  <view class="header">
    <view class="location-section">
      <image class="location-icon" src="/images/location.svg" mode="aspectFit"></image>
      <view class="location-text">
        <text class="deliver-label">Deliver Here</text>
        <view class="address-row">
          <text class="address">Apartment 1203, Al Furjan..</text>
          <text class="dropdown-arrow">&#x25BE;</text>
        </view>
      </view>
    </view>
    <view class="header-icons">
      <view class="icon-btn-wrap" bindtap="onFavoriteTap">
        <text class="icon-heart">&#x2661;</text>
      </view>
      <view class="icon-btn-wrap" bindtap="onNotificationTap">
        <text class="icon-bell">&#x1F514;</text>
      </view>
    </view>
  </view>

  <!-- Search Bar -->
  <view class="search-container">
    <view class="search-bar" bindtap="onSearchTap">
      <text class="search-icon-text">&#x1F50D;</text>
      <text class="search-placeholder">Search...</text>
    </view>
  </view>

  <!-- Scrollable Content -->
  <scroll-view scroll-y class="content-scroll" style="height: {{scrollHeight}}px;" bindscroll="onContentScroll">

    <!-- Banner Carousel -->
    <view class="carousel-section">
      <swiper class="banner-swiper" indicator-dots indicator-color="#CCE19F" indicator-active-color="#90CA14" autoplay interval="{{3000}}" circular current="{{currentBanner}}" bindchange="onBannerChange">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item">
            <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="banner-overlay"></view>
            <view class="banner-content">
              <view class="banner-discount-row">
                <text class="banner-discount-num">{{item.discountNum}}</text>
                <view class="banner-discount-symbols">
                  <text class="banner-percent">%</text>
                  <text class="banner-off">OFF</text>
                </view>
              </view>
              <text class="banner-title">{{item.title}}</text>
              <text class="banner-subtitle">{{item.subtitle}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- Filter Horizontal Bar -->
    <view class="filter-section">
      <view class="filter-tabs">
        <view class="filter-icon-btn" bindtap="onFilterTap">
          <text class="filter-icon-text">&#x2630;</text>
        </view>
        <scroll-view class="tabs-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="tabs-track">
            <block wx:for="{{filterTabs}}" wx:key="value">
              <view class="tab-item {{activeTab === item.value ? 'active' : ''}}" bindtap="onTabChange" data-value="{{item.value}}">
                <text>{{item.label}}</text>
              </view>
            </block>
          </view>
        </scroll-view>
        <!-- Veg Toggle -->
        <view class="veg-toggle" bindtap="toggleVeg">
          <view class="veg-toggle-track {{vegOnly ? 'on' : ''}}">
            <view class="veg-toggle-thumb">
              <view class="veg-indicator">
                <view class="veg-dot"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Healthy Savings Section -->
    <view class="section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-title">Healthy Savings</text>
          <text class="section-emoji">&#x1F4B0;</text>
        </view>
        <text class="section-subtitle">Popular healthy picks near you</text>
      </view>
      <scroll-view class="horizontal-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="meal-cards-row">
          <block wx:for="{{healthySavings}}" wx:key="id">
            <view class="meal-card" bindtap="onMealTap" data-id="{{item.id}}">
              <view class="meal-image-wrap">
                <image class="meal-image" src="{{item.image}}" mode="aspectFill"></image>
                <!-- Diet Badge -->
                <view class="diet-badge {{item.dietType}}">
                  <view class="diet-badge-dot"></view>
                </view>
                <!-- Heart -->
                <view class="heart-btn" catchtap="onHeartTap" data-id="{{item.id}}">
                  <text class="heart-icon {{item.liked ? 'liked' : ''}}">&#x2661;</text>
                </view>
              </view>
              <view class="meal-info">
                <text class="meal-name">{{item.name}}</text>
                <text class="meal-vendor">{{item.restaurant}}</text>
              </view>
              <view class="meal-footer">
                <view class="calories-row">
                  <image class="fire-icon" src="/images/fire.svg" mode="aspectFit"></image>
                  <text class="calories-text">{{item.calories}}+ kcal</text>
                </view>
                <view class="add-btn" catchtap="onAddMeal" data-id="{{item.id}}">
                  <text class="add-plus">+</text>
                  <text class="add-text">Add</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- Protein Picks Section -->
    <view class="section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-title">Protein Picks</text>
          <text class="section-emoji">&#x1F4AA;</text>
        </view>
        <text class="section-subtitle">High-protein meals to keep you full longer</text>
      </view>
      <scroll-view class="horizontal-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="meal-cards-row">
          <block wx:for="{{proteinPicks}}" wx:key="id">
            <view class="meal-card" bindtap="onMealTap" data-id="{{item.id}}">
              <view class="meal-image-wrap">
                <image class="meal-image" src="{{item.image}}" mode="aspectFill"></image>
                <view class="diet-badge {{item.dietType}}">
                  <view class="diet-badge-dot"></view>
                </view>
                <view class="heart-btn" catchtap="onHeartTap" data-id="{{item.id}}">
                  <text class="heart-icon {{item.liked ? 'liked' : ''}}">&#x2661;</text>
                </view>
              </view>
              <view class="meal-info">
                <text class="meal-name">{{item.name}}</text>
                <text class="meal-vendor">{{item.restaurant}}</text>
              </view>
              <view class="meal-footer">
                <view class="calories-row">
                  <text class="leaf-icon">&#x1F33F;</text>
                  <text class="calories-text">{{item.calories}}+ kcal</text>
                </view>
                <view class="add-btn-green" catchtap="onAddMeal" data-id="{{item.id}}">
                  <text class="add-text-white">Add</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- Light & Easy Section -->
    <view class="section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-title">Light & Easy</text>
          <text class="section-emoji">&#x1F957;</text>
        </view>
        <text class="section-subtitle">For late dinners or digestion-friendly meals</text>
      </view>

      <block wx:for="{{lightEasy}}" wx:key="id">
        <view class="large-meal-card" bindtap="onMealTap" data-id="{{item.id}}">
          <view class="large-image-wrap">
            <image class="large-meal-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="large-overlay"></view>
            <!-- Diet Badge -->
            <view class="diet-badge large-badge {{item.dietType}}">
              <view class="diet-badge-dot"></view>
            </view>
            <!-- Heart -->
            <view class="heart-btn large-heart" catchtap="onHeartTap" data-id="{{item.id}}">
              <text class="heart-icon">&#x2661;</text>
            </view>
            <!-- Bottom Info Overlay -->
            <view class="large-meal-overlay-info">
              <view class="large-meal-text">
                <text class="large-meal-name">{{item.name}}</text>
                <text class="large-meal-vendor">{{item.restaurant}}</text>
              </view>
              <view class="large-meal-right">
                <view class="large-cost">
                  <text class="dirham-symbol">AED</text>
                  <text class="large-price">{{item.price}}</text>
                </view>
                <view class="large-calories">
                  <image class="fire-icon-sm" src="/images/fire.svg" mode="aspectFit"></image>
                  <text class="large-cal-text">{{item.calories}}+ kcal</text>
                </view>
              </view>
            </view>
          </view>
          <!-- Tags -->
          <view class="meal-tags">
            <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
              <view class="tag-pill">
                <text class="tag-text">{{tag}}</text>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <!-- Bottom Spacer -->
    <view class="bottom-spacing"></view>
  </scroll-view>

  <!-- Floating Plan My Meal Card -->
  <view class="floating-plan-card" bindtap="onPlanMealTap">
    <view class="plan-left">
      <text class="plan-calendar-icon">&#x1F4C5;</text>
      <view class="plan-text">
        <text class="plan-title">Plan My Meal</text>
        <text class="plan-subtitle">Plan once, enjoy all week.</text>
      </view>
    </view>
    <view class="plan-arrow-btn">
      <text class="plan-arrow">&#x2197;</text>
    </view>
  </view>

  <!-- Bottom Navigation Bar -->
  <view class="bottom-nav">
    <view class="nav-item active" bindtap="onNavTap" data-tab="home">
      <text class="nav-icon-text nav-home">&#x2302;</text>
      <text class="nav-label active">Home</text>
    </view>
    <view class="nav-item" bindtap="onNavTap" data-tab="plan">
      <text class="nav-icon-text">&#x1F371;</text>
      <text class="nav-label">My Plan</text>
    </view>
    <view class="nav-item" bindtap="onNavTap" data-tab="activity">
      <text class="nav-icon-text">&#x1F464;</text>
      <text class="nav-label">My Activity</text>
    </view>
    <!-- Home Indicator -->
    <view class="home-indicator">
      <view class="indicator-bar"></view>
    </view>
  </view>
</view>
