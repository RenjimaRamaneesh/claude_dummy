page {
  height: 100vh;
  background: #F5F5F5;
}

/* ========== Page Container ========== */
.page-container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ========== Shade Gradient ========== */
.shade-gradient {
  position: absolute;
  width: 100%;
  height: 200rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 0 0 80rpx 80rpx;
  z-index: 0;
}

/* ========== Status Bar ========== */
.status-bar {
  width: 100%;
  position: relative;
  z-index: 1;
}

/* ========== Header ========== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 40rpx 20rpx;
  position: relative;
  z-index: 1;
}

.location-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.location-pin {
  width: 28rpx;
  height: 28rpx;
  background: #456401;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  position: relative;
}

.location-pin::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.location-text {
  display: flex;
  flex-direction: column;
}

.deliver-label {
  font-weight: 700;
  font-size: 28rpx;
  line-height: 32rpx;
  color: #456401;
}

.address-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.address {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #1E1E1E;
}

.dropdown-arrow {
  font-size: 28rpx;
  color: #1E1E1E;
}

.header-icons {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.icon-btn-wrap {
  width: 56rpx;
  height: 56rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 20rpx rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 28rpx;
  color: #949494;
  line-height: 1;
}

.header-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.location-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ========== Search Bar ========== */
.search-container {
  padding: 0 40rpx 20rpx;
  position: relative;
  z-index: 1;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  box-shadow: 0 0 100rpx rgba(30, 30, 30, 0.2);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  gap: 16rpx;
}

.search-icon-text {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-weight: 500;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #949494;
}

/* ========== Banner Carousel (outside scroll-view) ========== */
.carousel-section {
  padding: 0 40rpx;
  margin-bottom: 20rpx;
  max-height: 380rpx;
  opacity: 1;
  overflow: hidden;
  position: relative;
  z-index: 1;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.3s ease,
    margin-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1),
    padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.carousel-section.collapsed {
  max-height: 0;
  opacity: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.banner-swiper {
  height: 324rpx;
  border-radius: 24rpx;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-bg {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #E8F5D0 0%, #CCE19F 50%, #B8D48A 100%);
}

.banner-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60.8%, rgba(0, 0, 0, 0.05) 100%);
  border-radius: 24rpx;
}

.banner-content {
  position: absolute;
  bottom: 24rpx;
  left: 32rpx;
  right: 32rpx;
}

.banner-discount-row {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.banner-discount-num {
  font-weight: 800;
  font-size: 96rpx;
  line-height: 80rpx;
  color: #456401;
}

.banner-discount-symbols {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.banner-percent {
  font-weight: 600;
  font-size: 56rpx;
  line-height: 56rpx;
  color: #456401;
}

.banner-off {
  font-weight: 500;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #456401;
}

.banner-title {
  font-weight: 600;
  font-size: 40rpx;
  line-height: 48rpx;
  color: #1E1E1E;
  display: block;
}

.banner-subtitle {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #1E1E1E;
  display: block;
  margin-top: 4rpx;
}

/* ========== Filter Horizontal Bar (below carousel, sticky) ========== */
.filter-section {
  padding: 0 40rpx 20rpx;
  position: relative;
  z-index: 2;
  background: #FFFFFF;
}

.filter-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-icon-btn {
  width: 64rpx;
  height: 64rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 20rpx rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.filter-icon-text {
  font-size: 32rpx;
  color: #90CA14;
}

.filter-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.tabs-scroll {
  flex: 1;
  white-space: nowrap;
}

.tabs-track {
  display: inline-flex;
  gap: 10rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 20rpx rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.tab-item text {
  font-weight: 600;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #929292;
  white-space: nowrap;
}

.tab-item.active {
  background: #1E1E1E;
}

.tab-item.active text {
  color: #FFFFFF;
}

/* Veg Toggle */
.veg-toggle {
  flex-shrink: 0;
}

.veg-toggle-track {
  width: 94rpx;
  height: 56rpx;
  background: #C0C0C0;
  border-radius: 40rpx;
  position: relative;
  transition: background 0.3s;
}

.veg-toggle-track.on {
  background: #90CA14;
}

.veg-toggle-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left 0.3s;
}

.veg-toggle-track.on .veg-toggle-thumb {
  left: 44rpx;
}

.veg-indicator {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #15845E;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.veg-dot {
  width: 12rpx;
  height: 12rpx;
  background: #15835D;
  border-radius: 50%;
}

/* ========== Content Scroll ========== */
.content-scroll {
  position: relative;
  z-index: 1;
  background: #FFFFFF;
  flex: 1;
}

/* ========== Sections ========== */
.section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.section-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1E1E1E;
}

.section-emoji {
  font-size: 32rpx;
}

.section-emoji-img {
  width: 36rpx;
  height: 36rpx;
}

.section-subtitle {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #1E1E1E;
}

/* ========== Loading States ========== */
.loading-row {
  display: flex;
  gap: 28rpx;
  overflow: hidden;
}

.loading-card {
  width: 254rpx;
  flex-shrink: 0;
}

.loading-image-placeholder {
  width: 254rpx;
  height: 254rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 12rpx;
}

.loading-text-placeholder {
  width: 180rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 8rpx;
}

.loading-text-short {
  width: 120rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.loading-column {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.loading-large-card {
  border-radius: 40rpx;
  overflow: hidden;
}

.loading-large-image {
  width: 100%;
  height: 300rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ========== Empty State ========== */
.empty-state {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 24rpx;
  color: #949494;
}

/* ========== Horizontal Scroll ========== */
.horizontal-scroll {
  white-space: nowrap;
  margin: 0 -40rpx;
  padding: 0 40rpx;
}

.meal-cards-row {
  display: inline-flex;
  gap: 28rpx;
  padding-bottom: 8rpx;
}

/* ========== Small Meal Card ========== */
.meal-card {
  width: 254rpx;
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: column;
  white-space: normal;
}

.meal-image-wrap {
  width: 254rpx;
  height: 254rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 12rpx;
  background: #f5f5f5;
}

.meal-image {
  width: 100%;
  height: 100%;
}

/* Diet Badge */
.diet-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.diet-badge.nonveg {
  background: #D93B3B;
}

.diet-badge.veg {
  background: #90CA14;
}

.diet-badge.egg {
  background: #F7A42F;
}

.diet-badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

.diet-badge.nonveg .diet-badge-dot {
  background: #D93B3B;
}

.diet-badge.veg .diet-badge-dot {
  background: #90CA14;
}

.diet-badge.egg .diet-badge-dot {
  background: #F7A42F;
}

/* Heart Button */
.heart-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-icon {
  font-size: 28rpx;
  color: #FFFFFF;
}

.heart-icon.liked {
  color: #FF4444;
}

.heart-icon-img {
  width: 28rpx;
  height: 28rpx;
}

/* Meal Info */
.meal-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.meal-name {
  font-weight: 800;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #1E1E1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-vendor {
  font-weight: 500;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #757575;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Meal Footer */
.meal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.calories-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.fire-icon {
  width: 32rpx;
  height: 32rpx;
}

.fire-icon-sm {
  width: 28rpx;
  height: 28rpx;
}

.fire-icon-text {
  font-size: 24rpx;
  line-height: 1;
}

.fire-icon-text-sm {
  font-size: 20rpx;
  line-height: 1;
}

.calories-text {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #1E1E1E;
}

/* Add Button (Healthy Savings style) */
.add-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #CCE19F;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.add-plus {
  font-weight: 700;
  font-size: 24rpx;
  color: #456401;
  line-height: 1;
}

.add-text {
  font-weight: 600;
  font-size: 24rpx;
  line-height: 28rpx;
  color: #456401;
}

/* Add Button (Protein Picks - green filled) */
.add-btn-green {
  background: #81B80D;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.add-text-white {
  font-weight: 600;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #FFFFFF;
}

/* ========== Large Meal Card (All Menu) ========== */
.large-meal-card {
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 24rpx rgba(0, 0, 0, 0.2);
  border-radius: 40rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.large-image-wrap {
  width: 100%;
  height: 300rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: #f5f5f5;
}

.large-meal-image {
  width: 100%;
  height: 100%;
}

.large-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35.33%, rgba(0, 0, 0, 0.6) 100%);
}

.large-badge {
  top: 24rpx;
  left: 24rpx;
}

.large-heart {
  top: 24rpx;
  right: 24rpx;
}

.large-meal-overlay-info {
  position: absolute;
  bottom: 16rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.large-meal-text {
  display: flex;
  flex-direction: column;
}

.large-meal-name {
  font-weight: 700;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #FFFFFF;
}

.large-meal-vendor {
  font-weight: 500;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #FFFFFF;
}

.large-meal-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.large-cost {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.dirham-symbol {
  font-weight: 600;
  font-size: 24rpx;
  color: #FFFFFF;
}

.large-price {
  font-weight: 600;
  font-size: 32rpx;
  color: #FFFFFF;
}

.large-calories {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.large-cal-text {
  font-weight: 500;
  font-size: 24rpx;
  color: #FFFFFF;
}

/* Tags */
.meal-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 24rpx;
}

.tag-pill {
  background: #FFFFFF;
  border: 2rpx solid #949494;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.tag-text {
  font-weight: 500;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #456401;
}

/* ========== Floating Plan My Meal Card ========== */
.floating-plan-card {
  position: fixed;
  bottom: 210rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 596rpx;
  height: 108rpx;
  background: #F1FAEB;
  border: 4rpx solid #D9EFCB;
  box-shadow: 4rpx 4rpx 80rpx 4rpx rgba(30, 30, 30, 0.4);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  z-index: 100;
}

.plan-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plan-calendar-icon {
  font-size: 36rpx;
}

.plan-calendar-img {
  width: 40rpx;
  height: 40rpx;
}

.plan-text {
  display: flex;
  flex-direction: column;
}

.plan-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 38rpx;
  color: #456401;
}

.plan-subtitle {
  font-weight: 600;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #456401;
}

.plan-arrow-btn {
  width: 60rpx;
  height: 60rpx;
  background: #CCE19F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-arrow {
  font-size: 32rpx;
  color: #456401;
  font-weight: 700;
}

/* ========== Bottom Spacing ========== */
.bottom-spacing {
  height: 400rpx;
}

/* ========== Bottom Navigation Bar ========== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 40rpx rgba(0, 0, 0, 0.2);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 100;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0 8rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-icon-text {
  font-size: 44rpx;
  color: #757575;
  line-height: 1;
}

.nav-icon-text.nav-home {
  font-size: 48rpx;
}

.nav-item.active .nav-icon-text {
  color: #90CA14;
}

.nav-label {
  font-weight: 700;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #757575;
}

.nav-label.active {
  color: #90CA14;
}

/* Home Indicator */
.home-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

.indicator-bar {
  width: 288rpx;
  height: 10rpx;
  background: #000000;
  border-radius: 200rpx;
}
