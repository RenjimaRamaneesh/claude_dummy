/* pages/meal-detail/meal-detail.wxss */
/* Design: 430px width = 750rpx. Scale ~1.744 */

page {
  background: #FFFFFF;
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background: #FFFFFF;
  border-radius: 70rpx;
  overflow: hidden;
}

/* ========== HERO IMAGE ========== */
.hero-section {
  position: relative;
  width: 750rpx;
  height: 551rpx;
  flex-shrink: 0;
}

.hero-image {
  width: 100%;
  height: 100%;
  border-radius: 70rpx 70rpx 0 0;
}

.hero-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.2) 100%);
  pointer-events: none;
}

.status-bar-spacer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  pointer-events: none;
}

/* Veg/Non-Veg Indicator */
.veg-indicator {
  position: absolute;
  left: 21rpx;
  bottom: 42rpx;
  z-index: 5;
}

.veg-box {
  width: 21rpx;
  height: 21rpx;
  background: #FFFFFF;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.veg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.veg-dot.veg { background: #2E7D32; }
.veg-dot.non-veg { background: #D53B3B; }

/* Top Navigation */
.top-nav {
  position: absolute;
  top: 122rpx;
  left: 35rpx;
  right: 35rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  background: #E7E7E7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E1E1E;
  line-height: 1;
  margin-top: -4rpx;
}

.notif-btn {
  position: relative;
  width: 49rpx;
  height: 49rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notif-icon {
  font-size: 36rpx;
  color: #FFFFFF;
}

.notif-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 14rpx;
  height: 14rpx;
  background: #90CA14;
  border-radius: 50%;
}

/* ========== SCROLLABLE CONTENT ========== */
.content-scroll {
  flex: 1;
  background: #FFFFFF;
  margin-top: -70rpx;
  position: relative;
  z-index: 2;
}

/* Green shade at top */
.shade {
  width: 750rpx;
  height: 288rpx;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 35rpx;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
}

/* ========== MEAL INFO ========== */
.meal-info {
  position: relative;
  z-index: 1;
  padding: 40rpx 35rpx 20rpx;
}

.meal-title {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 42rpx;
  line-height: 120%;
  color: #1E1E1E;
  margin-bottom: 10rpx;
}

.meal-desc {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 23rpx;
  line-height: 140%;
  color: #777777;
}

/* ========== RESTAURANT ROW ========== */
.restaurant-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 35rpx 24rpx;
  gap: 12rpx;
}

.rest-by {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 21rpx;
  line-height: 28rpx;
  color: #1E1E1E;
}

.rest-dot {
  width: 12rpx;
  height: 12rpx;
  background: #90CA14;
  border-radius: 50%;
  flex-shrink: 0;
}

.rest-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star-char {
  font-size: 24rpx;
  color: #EEBD2B;
}

.rating-val {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 23rpx;
  color: #000000;
}

.rest-link {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.link-text {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 23rpx;
  color: #456401;
  text-decoration: underline;
}

.link-arrow {
  font-size: 28rpx;
  color: #456401;
  font-weight: 700;
}

/* ========== NUTRITION + PRICE ========== */
.nutrition-price-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 35rpx 24rpx;
}

.nutrition-values {
  display: flex;
  align-items: center;
}

.nutr-item {
  display: flex;
  flex-direction: column;
  padding: 0 14rpx;
}

.nutr-label {
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 24rpx;
  line-height: 120%;
  color: #1E1E1E;
  margin-bottom: 4rpx;
}

.fuel-label { color: #D93B3B; }

.nutr-val {
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 24rpx;
  line-height: 120%;
  color: #1E1E1E;
}

.fuel-val { color: #D93B3B; }

.nutr-divider {
  width: 7rpx;
  height: 73rpx;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 7rpx;
  flex-shrink: 0;
}

/* Price Badge */
.price-badge {
  width: 155rpx;
  height: 59rpx;
  background: #FFFFFF;
  box-shadow: 0 0 70rpx 2rpx rgba(30,30,30,0.2);
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.price-currency {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 22rpx;
  color: #1E1E1E;
}

.price-amount {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  color: #1E1E1E;
}

/* ========== ALLERGENS ========== */
.allergens-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 8rpx 35rpx 24rpx;
  gap: 14rpx;
}

.allergens-title {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  line-height: 140%;
  color: #000000;
  flex-shrink: 0;
}

.allergen-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.allergen-tag {
  background: #CCE19F;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.allergen-tag text {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 24rpx;
  color: #000000;
}

/* ========== HEALTH CARD (FLIP) ========== */
.health-card {
  position: relative;
  z-index: 1;
  margin: 20rpx 35rpx 0;
  height: 614rpx;
  perspective: 2000rpx;
}

.card-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s ease;
  transform-style: preserve-3d;
}

.card-flipper.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  background: #FFFFFF;
  box-shadow: 0 0 35rpx 2rpx rgba(30,30,30,0.2);
  border-radius: 35rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.back-face {
  transform: rotateY(180deg);
}

/* Card Header */
.hc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.hc-header-text { flex: 1; }

.hc-title {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #1E1E1E;
}

.hc-subtitle {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 23rpx;
  line-height: 100%;
  color: #000000;
  margin-top: 4rpx;
}

/* Compare Icon */
.compare-icon-btn {
  width: 70rpx;
  height: 70rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 21rpx rgba(0,0,0,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.compare-icon {
  font-size: 32rpx;
  color: #456401;
}

/* Chart + Legend */
.chart-legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 0 14rpx;
}

.chart-container {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.nutrition-canvas {
  width: 280rpx;
  height: 280rpx;
}

.chart-center-info {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fire-icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 4rpx;
}

.center-kcal {
  font-family: 'Manrope';
  font-weight: 800;
  font-size: 36rpx;
  line-height: 32rpx;
  color: #000000;
}

.center-unit {
  font-family: 'Manrope';
  font-weight: 800;
  font-size: 20rpx;
  color: #000000;
  margin-top: 4rpx;
}

/* Legend */
.legend-col {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-left: 28rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.legend-dot {
  width: 31rpx;
  height: 31rpx;
  border-radius: 7rpx;
  box-shadow: 2rpx 2rpx 21rpx 4rpx rgba(0,0,0,0.2);
  flex-shrink: 0;
}

.protein-bg { background: #54EAE7; }
.carbs-bg { background: #FAC58B; }
.fat-bg { background: #F28893; }

.legend-text {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 28rpx;
  line-height: 31rpx;
  color: #000000;
}

/* Good Choice */
.good-choice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: auto;
}

.tick-icon {
  width: 35rpx;
  height: 35rpx;
  flex-shrink: 0;
}

.gc-text {
  display: flex;
  flex-direction: column;
}

.gc-title {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  line-height: 35rpx;
  color: #000000;
}

.gc-sub {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 24rpx;
  line-height: 35rpx;
  color: #000000;
}

/* ========== NUTRITION TABLE (back) ========== */
.nutr-table {
  flex: 1;
  border: 3rpx solid #456401;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.table-hdr {
  display: flex;
  padding: 20rpx 24rpx;
}

.table-hdr .t-col {
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 26rpx;
  line-height: 31rpx;
  color: #000000;
}

.table-line {
  width: 100%;
  height: 2rpx;
  background: #949494;
}

.table-body-row {
  display: flex;
  padding: 20rpx 24rpx;
  align-items: center;
}

.t-col {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  line-height: 31rpx;
  color: #000000;
}

.t-col-label { flex: 2; }
.t-col-val { flex: 1; text-align: center; }

.fuel-type-cell {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fuel-type-cell text {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 24rpx;
  color: #000000;
}

.ft-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 7rpx;
  flex-shrink: 0;
}

/* ========== BOTTOM NAV ========== */
.scroll-bottom-spacer { height: 200rpx; }

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  box-shadow: 0 0 87rpx 3rpx rgba(30,30,30,0.1);
  border-radius: 38rpx 38rpx 0 0;
  padding: 18rpx 35rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.bottom-btn-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn {
  width: 457rpx;
  height: 80rpx;
  background: #90CA14;
  box-shadow: 3rpx 3rpx 35rpx rgba(0,0,0,0.25);
  border-radius: 28rpx;
  border: none;
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  color: #1E1E1E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  line-height: 80rpx;
  padding: 0;
}

/* Carted State */
.bottom-nav.carted { padding-top: 14rpx; }

.added-row {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 18rpx rgba(0,0,0,0.2);
  border-radius: 28rpx;
  margin-bottom: 14rpx;
  gap: 14rpx;
}

.added-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.cart-filled-icon {
  font-size: 32rpx;
  color: #456401;
}

.added-info {
  display: flex;
  flex-direction: column;
}

.added-label {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 28rpx;
  color: #000000;
}

.added-link {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 17rpx;
  color: #515151;
}

.added-divider-v {
  width: 3rpx;
  height: 66rpx;
  background: #DEDEDE;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.recycle-icon-wrap {
  width: 35rpx;
  height: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recycle-icon {
  font-size: 28rpx;
  color: #456401;
}

.carted-btn {
  width: 377rpx;
  background: #456401 !important;
  color: #FFFFFF !important;
}

/* ========== OVERLAY ========== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 999;
  pointer-events: none;
  transition: background 0.3s ease;
}

.overlay.show {
  background: rgba(0,0,0,0.5);
  pointer-events: auto;
}

/* ========== SHEET BASE ========== */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 70rpx 70rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet.show { transform: translateY(0); }

.sheet-handle-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 0;
}

.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  background: #D0D0D0;
  border-radius: 7rpx;
}

/* ========== RESTAURANT SHEET ========== */
.restaurant-sheet { max-height: 85vh; }

.rest-img-wrap {
  position: relative;
  width: 100%;
  height: 475rpx;
  flex-shrink: 0;
}

.rest-img {
  width: 100%;
  height: 100%;
  border-radius: 42rpx 42rpx 14rpx 14rpx;
}

.rest-img-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 100%);
  border-radius: 42rpx 42rpx 14rpx 14rpx;
  pointer-events: none;
}

.close-btn {
  position: absolute;
  top: 35rpx;
  right: 35rpx;
  width: 42rpx;
  height: 42rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 35rpx 7rpx rgba(0,0,0,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.close-x {
  font-size: 32rpx;
  font-weight: 400;
  color: #1E1E1E;
  line-height: 1;
}

.rest-scroll {
  flex: 1;
  padding: 28rpx 35rpx;
}

.rest-main-info { margin-bottom: 18rpx; }

.rest-name-lg {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 35rpx;
  line-height: 47rpx;
  color: #1E1E1E;
}

.rest-cat {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 23rpx;
  color: #777777;
  margin-left: 8rpx;
}

.rest-stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.rest-stat-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-star { font-size: 28rpx; color: #EEBD2B; }

.stat-text {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 24rpx;
  color: #000000;
}

.stat-text-light {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 24rpx;
  color: #000000;
}

.stat-loc-icon { width: 30rpx; height: 30rpx; }

.rest-desc {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 23rpx;
  line-height: 31rpx;
  color: #777777;
  margin-bottom: 28rpx;
}

/* Food Standards */
.standards-section { margin-bottom: 28rpx; }

.section-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.section-icon { width: 28rpx; height: 28rpx; }

.section-title-text {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  color: #000000;
}

.standards-scroll { white-space: nowrap; }

.standards-items {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 35rpx;
}

.standard-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 171rpx;
  height: 141rpx;
  border: 2rpx solid #456401;
  border-radius: 21rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 10rpx;
  box-sizing: border-box;
}

.standard-emoji { font-size: 36rpx; margin-bottom: 10rpx; }

.standard-label {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 21rpx;
  line-height: 120%;
  color: #456401;
  white-space: normal;
  text-align: center;
}

/* Specials */
.specials-section { margin-bottom: 28rpx; }
.bowl-icon { font-size: 28rpx; }
.specials-scroll { white-space: nowrap; }

.specials-items {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 35rpx;
}

.special-card {
  display: inline-block;
  width: 288rpx;
  flex-shrink: 0;
}

.special-img-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 21rpx;
  overflow: hidden;
}

.special-img { width: 100%; height: 100%; }

.special-img-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(179.84deg, rgba(0,0,0,0) 49.79%, rgba(0,0,0,0.8) 99.86%);
  pointer-events: none;
}

.special-price {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: #FFFFFF;
  border-radius: 7rpx;
  padding: 6rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.sp-currency {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 20rpx;
  color: #1E1E1E;
}

.sp-amount {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 24rpx;
  color: #1E1E1E;
}

.special-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 14rpx;
}

.special-tag {
  display: inline-block;
  border: 2.6rpx solid #FFFFFF;
  border-radius: 7rpx;
  padding: 4rpx 10rpx;
  margin-bottom: 6rpx;
}

.special-tag-text {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 21rpx;
  color: #FFFFFF;
}

.special-name {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 28rpx;
  line-height: 38rpx;
  color: #FFFFFF;
  white-space: normal;
}

.special-sub {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #FFFFFF;
  white-space: normal;
}

/* ========== CUSTOMIZE SHEET ========== */
.customize-sheet {
  max-height: 78vh;
  background: #F5F5F5;
}

.cust-header {
  background: linear-gradient(180deg, #90CA14 0%, #C8E58A 50%, #FFFFFF 100%);
  padding: 28rpx 42rpx 42rpx;
  flex-shrink: 0;
}

.cust-title {
  display: block;
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 42rpx;
  line-height: 42rpx;
  color: #1E1E1E;
  margin-bottom: 10rpx;
}

.cust-sub {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 23rpx;
  line-height: 42rpx;
  color: #000000;
}

.cust-scroll {
  flex: 1;
  padding: 24rpx 28rpx 0;
  background: #FFFFFF;
  border-radius: 38rpx 38rpx 0 0;
  margin-top: -20rpx;
}

/* Customize Cards */
.cust-card { margin-bottom: 24rpx; }

.bases-card {
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 21rpx rgba(0,0,0,0.2);
  border-radius: 35rpx;
  padding: 24rpx 28rpx;
}

.cust-section-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.cust-section-title {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #000000;
}

.cust-section-desc {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 21rpx;
  line-height: 42rpx;
  color: #949494;
  margin-bottom: 18rpx;
}

/* Badges */
.badge-mandatory {
  background: #FFDCDC;
  border: 2rpx dashed #D93B3B;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
}

.badge-mandatory text {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 17rpx;
  color: #D93B3B;
}

.badge-optional {
  background: #FFEACE;
  border: 2rpx dashed #E79119;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
}

.badge-optional text {
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 17rpx;
  color: #E79119;
}

/* Options */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.opt-row {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 14rpx;
  padding: 18rpx 14rpx;
  transition: all 0.2s ease;
}

.opt-row.opt-selected {
  background: #FFFFFF;
  box-shadow: 0 0 14rpx rgba(30,30,30,0.2);
}

.opt-indicator {
  width: 5rpx;
  height: 56rpx;
  border-radius: 35rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: transparent;
}

.opt-indicator.indicator-green {
  background: linear-gradient(360deg, #90CA14 0%, #EDFFC8 100%);
}

.opt-indicator.indicator-red {
  background: linear-gradient(360deg, #D93B3B 0%, #FFDCDC 100%);
}

.opt-info { flex: 1; min-width: 0; }

.opt-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.opt-name {
  display: block;
  font-family: 'Manrope';
  font-weight: 700;
  font-size: 21rpx;
  line-height: 140%;
  color: #4F4F4F;
}

.opt-desc {
  display: block;
  font-family: 'Manrope';
  font-weight: 500;
  font-size: 17rpx;
  line-height: 140%;
  color: #838383;
}

.recommended-icon { width: 21rpx; height: 21rpx; }

/* Radio */
.radio-outer {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2.6rpx solid #949494;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 14rpx;
  background: #FFFFFF;
}

.radio-outer.radio-active { border-color: #90CA14; }

.radio-inner {
  width: 16rpx;
  height: 16rpx;
  background: #456401;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
}

/* Checkbox */
.checkbox-outer {
  width: 24rpx;
  height: 24rpx;
  border-radius: 2rpx;
  border: 2.6rpx solid #949494;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 14rpx;
  background: #FFFFFF;
}

.checkbox-outer.cb-active { border-color: #90CA14; }

.cb-tick {
  font-size: 16rpx;
  color: #456401;
  font-weight: 700;
  line-height: 1;
}

/* ========== CUSTOMIZE FOOTER ========== */
.cust-footer {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F0F0F0;
  flex-shrink: 0;
}

.qty-selector {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  box-shadow: 2rpx 2rpx 18rpx rgba(0,0,0,0.2);
  border-radius: 28rpx;
  padding: 8rpx 14rpx;
  gap: 18rpx;
}

.qty-btn {
  width: 35rpx;
  height: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #456401;
  line-height: 1;
}

.qty-num {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 42rpx;
  line-height: 45rpx;
  color: #000000;
  min-width: 28rpx;
  text-align: center;
}

.done-btn {
  flex: 1;
  height: 80rpx;
  background: #456401;
  box-shadow: 2rpx 2rpx 35rpx rgba(0,0,0,0.25);
  border-radius: 28rpx;
  border: none;
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 28rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 80rpx;
  padding: 0;
}
