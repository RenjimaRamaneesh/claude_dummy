/* pages/meal-detail/meal-detail.wxss */
page {
  background: #FFFFFF;
  height: 100vh;
  font-family: 'Manrope', sans-serif;
}

.meal-details-container {
  position: relative;
  width: 750rpx;
  height: 100vh;
  background: #FFFFFF;
  overflow: hidden;
}

/* Hero Image Section */
.hero-image-wrapper {
  position: absolute;
  width: 750rpx;
  height: 551rpx;
  left: 0;
  top: 0;
  box-shadow: 0 0 35rpx 4rpx rgba(30, 30, 30, 0.2);
  border-radius: 70rpx 70rpx 0 0;
  overflow: hidden;
}

.main-image {
  width: 100%;
  height: 100%;
}

.image-shade {
  position: absolute;
  width: 100%;
  height: 288rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, rgba(255, 255, 255, 0) 100%);
  opacity: 0.6;
}

.veg-indicator {
  position: absolute;
  width: 21rpx;
  height: 21rpx;
  left: 21rpx;
  top: 509rpx;
  background: #FFFFFF;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.indicator-inner {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.veg .indicator-inner {
  background: #90CA14;
}

.non-veg .indicator-inner {
  background: #D53B3B;
}

/* Top Notch */
.top-notch {
  position: absolute;
  width: 680rpx;
  height: 56rpx;
  left: 35rpx;
  top: 122rpx;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-butt {
  width: 56rpx;
  height: 56rpx;
  background: #E7E7E7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-vector {
  width: 32rpx;
  height: 32rpx;
}

.notification-butt {
  width: 49rpx;
  height: 49rpx;
  position: relative;
}

.notif-vector {
  width: 42rpx;
  height: 42rpx;
}

.notif-dot {
  position: absolute;
  width: 17rpx;
  height: 17rpx;
  right: 4rpx;
  top: 4rpx;
  background: #90CA14;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

/* Scroll Content */
.main-scroll-view {
  position: absolute;
  width: 100%;
  height: calc(100% - 160rpx);
  top: 550rpx;
  background: #FFFFFF;
  border-radius: 70rpx 70rpx 0 0;
  margin-top: -70rpx;
  padding-bottom: 160rpx;
}

.main-txt-section {
  padding: 40rpx 35rpx 20rpx;
}

.meal-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1E1E1E;
  line-height: 1.2;
}

.meal-desc {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #777777;
  line-height: 1.4;
  margin-top: 10rpx;
}

/* Restaurant Details */
.restaurant-det {
  display: flex;
  align-items: center;
  padding: 0 35rpx;
  gap: 15rpx;
  height: 40rpx;
}

.rest-by {
  font-size: 21rpx;
  font-weight: 500;
  color: #1E1E1E;
}

.rest-rating {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
}

.rating-val {
  font-size: 23rpx;
  font-weight: 600;
  color: #000000;
}

.rest-dot {
  width: 12rpx;
  height: 12rpx;
  background: #90CA14;
  border-radius: 50%;
}

.view-link {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.view-link text {
  font-size: 23rpx;
  font-weight: 600;
  color: #456401;
  text-decoration: underline;
}

.link-vector {
  width: 21rpx;
  height: 21rpx;
}

/* Nutrition Row (Main Val) */
.main-val-row {
  position: relative;
  display: flex;
  align-items: center;
  margin: 30rpx 35rpx;
  padding: 20rpx 0;
  gap: 0;
}

.val-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 10rpx;
}

.val-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E1E1E;
  margin-bottom: 5rpx;
}

.val-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.color-red {
  color: #D93B3B;
}

.val-divider {
  width: 7rpx;
  height: 73rpx;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 7rpx;
  margin: 0 10rpx;
}

.cost-badge {
  position: absolute;
  right: 0;
  top: 7rpx;
  width: 155rpx;
  height: 59rpx;
  background: #FFFFFF;
  box-shadow: 0 0 70rpx 2rpx rgba(30, 30, 30, 0.2);
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dirham-symbol {
  width: 35rpx;
  height: 31rpx;
  background: url('https://img.icons8.com/ios/50/000000/currency-exchange.png') no-repeat center;
  background-size: contain;
}

.price-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
}

/* Allergens */
.allergens-container {
  display: flex;
  align-items: center;
  margin: 20rpx 35rpx;
  gap: 30rpx;
}

.allergens-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
}

.allergen-list {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.allergen-item {
  background: #CCE19F;
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
}

.allergen-item text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

/* Stat Sec (Health Card) */
.stat-sec {
  margin: 40rpx 35rpx;
  height: 614rpx;
  perspective: 1500rpx;
}

.stat-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.is-flipped .stat-card-inner {
  transform: rotateY(180deg);
}

.stat-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  background: #FFFFFF;
  box-shadow: 0 0 35rpx 2rpx rgba(30, 30, 30, 0.2);
  border-radius: 35rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.face-back {
  transform: rotateY(180deg);
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.stat-main-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.stat-sub-title {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #000000;
  margin-top: 5rpx;
}

.compare-icon {
  width: 70rpx;
  height: 70rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compare-vector {
  width: 42rpx;
  height: 42rpx;
}

/* Chart */
.chart-container {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 30rpx 0;
}

.chart-wrapper {
  position: relative;
  width: 350rpx;
  height: 350rpx;
}

.nutrition-chart {
  width: 100%;
  height: 100%;
}

.fuel-value-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fire-icon {
  width: 42rpx;
  height: 42rpx;
}

.kcal-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #000000;
  text-align: center;
  white-space: pre-wrap;
}

.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.legend-tab {
  width: 31rpx;
  height: 31rpx;
  border-radius: 7rpx;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.2);
}

.protein .legend-tab {
  background: #54EAE7;
}

.carbs .legend-tab {
  background: #FAC58B;
}

.fat .legend-tab {
  background: #F28893;
}

.legend-item text {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
}

/* Comparison Table */
.nutrition-table {
  margin: 30rpx 0;
  border: 4rpx solid #456401;
  border-radius: 28rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: #F9F9F9;
  padding: 15rpx 20rpx;
  border-bottom: 2rpx solid #E0E0E0;
}

.table-header text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #000000;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 20rpx;
  border-bottom: 2rpx dashed #949494;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.fuel-type {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.fuel-tab {
  width: 24rpx;
  height: 24rpx;
  border-radius: 7rpx;
}

.fuel-tab.protein {
  background: #54EAE7;
}

.fuel-tab.carbs {
  background: #FAC58B;
}

.fuel-tab.fat {
  background: #F28893;
}

.fuel-type text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.val-target,
.val-actual {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.con-txt-area {
  margin-top: auto;
  text-align: center;
}

.txt-icon-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.tick-circle {
  width: 35rpx;
  height: 35rpx;
  background: #90CA14;
  border-radius: 50%;
}

.good-choice-txt {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.bmi-goals-txt {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  margin-top: 5rpx;
}

/* Bottom Padding */
.bottom-padding {
  height: 200rpx;
}

/* Nav Bar */
.nav-bar {
  position: absolute;
  width: 750rpx;
  height: 160rpx;
  bottom: 0;
  z-index: 100;
}

.nav-bar-rect {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  box-shadow: 0 0 87rpx 4rpx rgba(30, 30, 30, 0.1);
  border-radius: 38rpx 38rpx 0 0;
}

.add-butt {
  position: absolute;
  width: 457rpx;
  height: 80rpx;
  left: 147rpx;
  bottom: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-butt-rect {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #90CA14;
  box-shadow: 4rpx 4rpx 35rpx rgba(0, 0, 0, 0.25);
  border-radius: 28rpx;
}

.add-text {
  position: relative;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.home-indicator {
  position: absolute;
  width: 100%;
  height: 59rpx;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.indicator-bar {
  width: 251rpx;
  height: 9rpx;
  background: #000000;
  border-radius: 174rpx;
}

/* Added Overlay */
.added-overlay {
  position: absolute;
  bottom: 160rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
  z-index: 99;
}

.customize-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #456401;
  text-decoration: underline;
}

/* Pop Ups Base */
.pop-up-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.pop-up-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* Restaurant Pop Up */
.rest-pop-up {
  position: fixed;
  width: 750rpx;
  height: 85vh;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.rest-pop-up.show {
  transform: translateY(0);
}

.rest-main-tab {
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  border-radius: 70rpx 70rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.pop-up-handle {
  width: 70rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 20rpx auto;
}

.rest-img-section {
  position: relative;
  width: 100%;
  height: 474rpx;
}

.rest-hero-img {
  width: 100%;
  height: 100%;
  border-radius: 42rpx 42rpx 14rpx 14rpx;
}

.cancel-butt {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  width: 42rpx;
  height: 41rpx;
}

.cancel-circle {
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 35rpx 7rpx rgba(0, 0, 0, 0.25);
  border-radius: 50%;
}

.cancel-icon {
  position: absolute;
  width: 25rpx;
  height: 25rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.rest-pop-content {
  flex: 1;
  padding: 30rpx 35rpx;
}

/* Restaurant Info */
.rest-info-header {
  margin-bottom: 30rpx;
}

.rest-names {
  margin-bottom: 15rpx;
}

.rest-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.rest-subtitle {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #777777;
  margin-top: 5rpx;
}

.rest-stats {
  margin-bottom: 15rpx;
}

.stat-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.stat-line text {
  font-size: 24rpx;
  font-weight: 500;
  color: #1E1E1E;
}

.stat-star {
  width: 28rpx;
  height: 28rpx;
}

.stat-loc {
  width: 28rpx;
  height: 28rpx;
}

.rest-bio {
  display: block;
  font-size: 22rpx;
  font-weight: 400;
  color: #777777;
  line-height: 1.5;
}

/* Food Standards */
.food-stds-section {
  margin: 30rpx 0;
}

.stds-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tick-circle-small {
  width: 28rpx;
  height: 28rpx;
  background: #90CA14;
  border-radius: 50%;
}

.stds-header text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.stds-scroll {
  white-space: nowrap;
}

.std-p-box {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  height: 180rpx;
  margin-right: 20rpx;
  position: relative;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.1);
  border-radius: 21rpx;
  padding: 20rpx;
  box-sizing: border-box;
  justify-content: center;
}

.std-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 10rpx;
}

.std-text {
  font-size: 18rpx;
  font-weight: 500;
  color: #1E1E1E;
  text-align: center;
  white-space: normal;
  word-wrap: break-word;
}

/* Today's Specials */
.specials-section {
  margin: 30rpx 0;
}

.specials-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.bowl-icon {
  width: 32rpx;
  height: 32rpx;
}

.specials-header text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.specials-scroll {
  white-space: nowrap;
}

.spec-menu-box {
  display: inline-block;
  position: relative;
  width: 300rpx;
  height: 350rpx;
  margin-right: 20rpx;
  border-radius: 21rpx;
  overflow: hidden;
}

.spec-img {
  width: 100%;
  height: 100%;
}

.spec-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.7) 100%);
}

.spec-tag {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 10rpx;
  padding: 5rpx 15rpx;
}

.spec-tag text {
  font-size: 18rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.spec-name-price {
  position: absolute;
  bottom: 15rpx;
  left: 15rpx;
  right: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.spec-name-container {
  flex: 1;
}

.spec-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.spec-desc-short {
  display: block;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 3rpx;
}

.spec-cost {
  display: flex;
  align-items: center;
  gap: 5rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 10rpx;
  padding: 5rpx 15rpx;
}

.dirham-icon-small {
  width: 20rpx;
  height: 20rpx;
  background: url('https://img.icons8.com/ios/50/000000/currency-exchange.png') no-repeat center;
  background-size: contain;
}

.spec-cost text {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E1E1E;
}

/* Customize Pop Up */
.customize-pop-up {
  position: fixed;
  width: 750rpx;
  height: 90vh;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 38rpx 38rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.customize-pop-up.show {
  transform: translateY(0);
}

.cust-nav-bar {
  padding: 40rpx 35rpx 20rpx;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 38rpx 38rpx 0 0;
}

.cust-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.cust-subtitle {
  display: block;
  font-size: 21rpx;
  font-weight: 500;
  color: #777777;
  margin-top: 5rpx;
}

.cust-scroll-content {
  height: calc(90vh - 300rpx);
}

.cust-section {
  padding: 30rpx 35rpx;
  margin-bottom: 20rpx;
}

.section-hdr {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sect-title {
  font-size: 26rpx;
  font-weight: 600;
}

.manda-tag {
  background: #FFDCDC;
  border: 2rpx dashed #D93B3B;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
  font-size: 17rpx;
  color: #D93B3B;
}

.option-tag {
  background: #FFEACE;
  border: 2rpx dashed #E79119;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
  font-size: 17rpx;
  color: #E79119;
}

.sect-desc {
  font-size: 21rpx;
  color: #949494;
}

/* Form Elements - Base Options */
.opt-item {
  position: relative;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.2);
  border-radius: 14rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.side-indicator {
  width: 5rpx;
  height: 56rpx;
  border-radius: 35rpx;
  margin-right: 15rpx;
}

.bases .opt-item.active .side-indicator {
  background: linear-gradient(360deg, #D93B3B 0%, #FFDCDC 100%);
}

.bases .opt-item:not(.active) .side-indicator {
  background: linear-gradient(360deg, #90CA14 0%, #EDFFC8 100%);
}

.opt-info {
  flex: 1;
}

.opt-name {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  color: #4F4F4F;
}

.opt-sub {
  font-size: 17rpx;
  color: #838383;
}

.radio-butt {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #949494;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-butt.checked {
  border-color: #90CA14;
}

.radio-dot {
  width: 14rpx;
  height: 14rpx;
  background: #456401;
  border-radius: 50%;
}

/* Form Elements - Flat Options (Sides & Drinks) */
.opt-list-flat {
  margin-top: 15rpx;
}

.opt-item-flat {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 15rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.1);
  border-radius: 14rpx;
}

.opt-item-flat.active {
  border: 2rpx solid #90CA14;
}

.name-rec-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rec-icon {
  width: 28rpx;
  height: 28rpx;
  background: #90CA14;
  border-radius: 50%;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #949494;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-box.checked {
  background: #90CA14;
  border-color: #90CA14;
}

.check-vector {
  width: 20rpx;
  height: 20rpx;
}

/* Customize Footer */
.cust-footer {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 160rpx;
  padding: 20rpx 35rpx;
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

.quant-tab {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 17rpx rgba(0, 0, 0, 0.2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.minus-butt {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.minus-vector {
  width: 35rpx;
  height: 5rpx;
  background: #456401;
}

.plus-butt {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-vector {
  width: 35rpx;
  height: 35rpx;
}

.quant-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.schedule-butt {
  flex: 2;
  height: 80rpx;
  background: #456401;
  box-shadow: 4rpx 4rpx 35rpx rgba(0, 0, 0, 0.25);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Bottom Padding */
.bottom-padding-large {
  height: 300rpx;
}
