/* pages/meal-detail/meal-detail.wxss */

page {
  background: #FFFFFF;
  height: 100vh;
  font-family: 'Manrope', sans-serif;
}

.meal-details-container {
  position: relative;
  width: 750rpx;
  height: 100vh;
  background: #FFFFFF;
  overflow: hidden;
}

/* ========== HERO IMAGE SECTION ========== */
.hero-image-wrapper {
  position: absolute;
  width: 750rpx;
  height: 551rpx;
  left: 0;
  top: 0;
  box-shadow: 0 0 35rpx 4rpx rgba(30, 30, 30, 0.2);
  border-radius: 70rpx 70rpx 0 0;
  overflow: hidden;
}

.main-image {
  width: 100%;
  height: 100%;
}

.image-shade {
  position: absolute;
  width: 100%;
  height: 288rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, rgba(255, 255, 255, 0) 100%);
  opacity: 0.6;
}

.veg-indicator {
  position: absolute;
  width: 21rpx;
  height: 21rpx;
  left: 21rpx;
  top: 509rpx;
  background: #FFFFFF;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.indicator-inner {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.veg .indicator-inner { background: #90CA14; }
.non-veg .indicator-inner { background: #D53B3B; }

/* ========== TOP NOTCH ========== */
.top-notch {
  position: absolute;
  width: 680rpx;
  height: 56rpx;
  left: 35rpx;
  top: 122rpx;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-butt {
  width: 56rpx;
  height: 56rpx;
  background: #E7E7E7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E1E1E;
  line-height: 1;
  margin-top: -4rpx;
}

.notification-butt {
  width: 49rpx;
  height: 49rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notif-bell-text {
  font-size: 36rpx;
  color: #FFFFFF;
}

.notif-dot {
  position: absolute;
  width: 17rpx;
  height: 17rpx;
  right: 4rpx;
  top: 4rpx;
  background: #90CA14;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

/* ========== SCROLL CONTENT ========== */
.main-scroll-view {
  position: absolute;
  width: 100%;
  height: calc(100% - 160rpx);
  top: 480rpx;
  z-index: 2;
  border-radius: 35rpx 35rpx 0 0;
  overflow: hidden;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 288rpx);
  padding-bottom: 160rpx;
}

.main-txt-section {
  padding: 40rpx 35rpx 20rpx;
}

.meal-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1E1E1E;
  line-height: 1.2;
}

.meal-desc {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #777777;
  line-height: 1.4;
  margin-top: 10rpx;
}

/* ========== RESTAURANT DETAILS ========== */
.restaurant-det {
  display: flex;
  align-items: center;
  padding: 0 35rpx;
  gap: 15rpx;
  height: 40rpx;
}

.rest-by {
  font-size: 21rpx;
  font-weight: 500;
  color: #1E1E1E;
}

.rest-rating {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.star-char {
  font-size: 24rpx;
  color: #EEBD2B;
}

.rating-val {
  font-size: 23rpx;
  font-weight: 600;
  color: #000000;
}

.rest-dot {
  width: 12rpx;
  height: 12rpx;
  background: #90CA14;
  border-radius: 50%;
}

.view-link {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.view-link text {
  font-size: 23rpx;
  font-weight: 600;
  color: #456401;
  text-decoration: underline;
}

.link-arrow {
  font-size: 28rpx;
  color: #456401;
  font-weight: 700;
  text-decoration: none !important;
}

/* ========== NUTRITION ROW (Main Val) ========== */
.main-val-row {
  position: relative;
  display: flex;
  align-items: center;
  margin: 30rpx 35rpx;
  padding: 20rpx 0;
  gap: 0;
}

.val-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 10rpx;
}

.val-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E1E1E;
  margin-bottom: 5rpx;
}

.val-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.color-red { color: #D93B3B; }

.val-divider {
  width: 7rpx;
  height: 73rpx;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 7rpx;
  margin: 0 10rpx;
}

.cost-badge {
  position: absolute;
  right: 0;
  top: 7rpx;
  width: 155rpx;
  height: 59rpx;
  background: #FFFFFF;
  box-shadow: 0 0 70rpx 2rpx rgba(30, 30, 30, 0.2);
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dirham-text {
  font-family: 'Manrope';
  font-weight: 600;
  font-size: 22rpx;
  color: #1E1E1E;
}

.price-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
}

/* ========== ALLERGENS ========== */
.allergens-container {
  display: flex;
  align-items: center;
  margin: 20rpx 35rpx;
  gap: 30rpx;
}

.allergens-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
}

.allergen-list {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.allergen-item {
  background: #CCE19F;
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
}

.allergen-item text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

/* ========== STAT SEC (Health Card) ========== */
.stat-sec {
  margin: 40rpx 35rpx;
  height: 614rpx;
  perspective: 1500rpx;
}

.stat-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}

.is-flipped .stat-card-inner {
  transform: rotateY(180deg);
}

.stat-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  background: #FFFFFF;
  box-shadow: 0 0 35rpx 2rpx rgba(30, 30, 30, 0.2);
  border-radius: 35rpx;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.face-back {
  transform: rotateY(180deg);
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.stat-main-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E1E1E;
}

.stat-sub-title {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  color: #000000;
  margin-top: 5rpx;
}

.compare-icon {
  width: 70rpx;
  height: 70rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.compare-vector {
  width: 32rpx;
  height: 32rpx;
}

/* ========== CHART ========== */
.chart-container {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex: 1;
  padding: 0 14rpx;
}

.chart-wrapper {
  position: relative;
  width: 350rpx;
  height: 350rpx;
  flex-shrink: 0;
}

.nutrition-chart {
  width: 100%;
  height: 100%;
}

.fuel-value-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fire-icon {
  width: 42rpx;
  height: 42rpx;
}

.kcal-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #000000;
  text-align: center;
  white-space: pre-wrap;
}

.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.legend-tab {
  width: 31rpx;
  height: 31rpx;
  border-radius: 7rpx;
  box-shadow: 4rpx 4rpx 21rpx rgba(0, 0, 0, 0.2);
}

.protein .legend-tab { background: #54EAE7; }
.carbs .legend-tab { background: #FAC58B; }
.fat .legend-tab { background: #F28893; }

.legend-item text {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
}

/* ========== COMPARISON TABLE ========== */
.nutrition-table {
  flex: 1;
  border: 4rpx solid #456401;
  border-radius: 28rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.table-header {
  display: flex;
  background: #F9F9F9;
  padding: 15rpx 20rpx;
  border-bottom: 2rpx solid #E0E0E0;
}

.table-header text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #000000;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 20rpx;
  border-bottom: 2rpx dashed #949494;
  align-items: center;
}

.table-row:last-child { border-bottom: none; }

.fuel-type {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.fuel-tab {
  width: 24rpx;
  height: 24rpx;
  border-radius: 7rpx;
}

.fuel-tab.protein { background: #54EAE7; }
.fuel-tab.carbs { background: #FAC58B; }
.fuel-tab.fat { background: #F28893; }

.fuel-type text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
}

.val-target, .val-actual {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.con-txt-area {
  margin-top: auto;
  text-align: center;
}

.txt-icon-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.tick-circle-icon {
  width: 35rpx;
  height: 35rpx;
  flex-shrink: 0;
}

.good-choice-txt {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.bmi-goals-txt {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  margin-top: 5rpx;
}

/* ========== NAV BAR ========== */
.bottom-padding { height: 80rpx; }

.nav-bar {
  position: absolute;
  width: 750rpx;
  height: 160rpx;
  bottom: 0;
  z-index: 100;
}

.nav-bar-rect {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  box-shadow: 0 0 87rpx 4rpx rgba(30, 30, 30, 0.1);
  border-radius: 38rpx 38rpx 0 0;
}

.add-butt {
  position: absolute;
  width: 457rpx;
  height: 80rpx;
  left: 147rpx;
  bottom: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-butt-rect {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #90CA14;
  box-shadow: 4rpx 4rpx 35rpx rgba(0, 0, 0, 0.25);
  border-radius: 28rpx;
}

.add-butt.active .add-butt-rect {
  background: #456401;
}

.add-text {
  position: relative;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.add-butt.active .add-text {
  color: #FFFFFF;
}

.home-indicator {
  position: absolute;
  width: 100%;
  height: 59rpx;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.indicator-bar {
  width: 251rpx;
  height: 9rpx;
  background: #000000;
  border-radius: 174rpx;
}

/* Added overlay */
.added-overlay {
  position: absolute;
  bottom: 160rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 10rpx 0;
  z-index: 99;
}

.customize-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #456401;
  text-decoration: underline;
}

/* ========== POP UPS BASE ========== */
.pop-up-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 999;
  pointer-events: none;
  transition: background 0.3s ease;
}

.pop-up-overlay.show {
  background: rgba(0,0,0,0.5);
  pointer-events: auto;
}

/* ========== RESTAURANT POP UP ========== */
.rest-pop-up {
  position: fixed;
  width: 750rpx;
  max-height: 85vh;
  bottom: 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1000;
}

.rest-pop-up.show {
  transform: translateY(0);
}

.rest-main-tab {
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  border-radius: 70rpx 70rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.pop-up-handle {
  width: 70rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 20rpx auto;
}

.rest-img-section {
  position: relative;
  width: 100%;
  height: 474rpx;
  flex-shrink: 0;
}

.rest-hero-img {
  width: 100%;
  height: 100%;
  border-radius: 42rpx 42rpx 14rpx 14rpx;
}

.cancel-butt {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 35rpx 7rpx rgba(0, 0, 0, 0.25);
  border-radius: 50%;
}

.cancel-x {
  position: relative;
  font-size: 32rpx;
  font-weight: 400;
  color: #1E1E1E;
  line-height: 1;
  z-index: 1;
}

.rest-pop-content {
  flex: 1;
  padding: 30rpx 35rpx;
}

.rest-info-header {
  margin-bottom: 18rpx;
}

.rest-names {
  margin-bottom: 10rpx;
}

.rest-title {
  display: block;
  font-size: 35rpx;
  font-weight: 700;
  color: #1E1E1E;
  line-height: 47rpx;
}

.rest-subtitle {
  font-size: 23rpx;
  font-weight: 500;
  color: #777777;
  margin-left: 8rpx;
}

.rest-stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.stat-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-star {
  font-size: 28rpx;
  color: #EEBD2B;
}

.stat-line text {
  font-size: 24rpx;
  font-weight: 600;
  color: #000000;
}

.stat-loc {
  width: 30rpx;
  height: 30rpx;
}

.rest-bio {
  display: block;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 31rpx;
  color: #777777;
  margin-bottom: 28rpx;
}

/* Food Standards */
.food-stds-section {
  margin-bottom: 28rpx;
}

.stds-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.stds-header-icon {
  width: 28rpx;
  height: 28rpx;
}

.stds-header text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.stds-scroll {
  white-space: nowrap;
}

.stds-items-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 35rpx;
}

.std-p-box {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 171rpx;
  height: 141rpx;
  border: 2rpx solid #456401;
  border-radius: 21rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 10rpx;
  box-sizing: border-box;
}

.std-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 10rpx;
}

.std-text {
  font-size: 21rpx;
  font-weight: 500;
  line-height: 120%;
  color: #456401;
  white-space: normal;
  text-align: center;
}

/* Specials */
.specials-section {
  margin-bottom: 28rpx;
}

.specials-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.bowl-icon {
  width: 28rpx;
  height: 28rpx;
}

.specials-header text {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.specials-scroll {
  white-space: nowrap;
}

.specials-items-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 35rpx;
}

.spec-menu-box {
  display: inline-block;
  position: relative;
  width: 288rpx;
  height: 420rpx;
  border-radius: 21rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.spec-img {
  width: 100%;
  height: 100%;
}

.spec-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.8) 100%);
  pointer-events: none;
}

.spec-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  border: 2.6rpx solid #FFFFFF;
  border-radius: 7rpx;
  padding: 4rpx 10rpx;
}

.spec-tag text {
  font-size: 21rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.spec-name-price {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.spec-name-container {
  flex: 1;
}

.spec-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: #FFFFFF;
  white-space: normal;
}

.spec-desc-short {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  color: #FFFFFF;
  white-space: normal;
}

.spec-cost {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFFFFF;
  border-radius: 7rpx;
  padding: 6rpx 12rpx;
  flex-shrink: 0;
}

.spec-currency {
  font-size: 20rpx;
  font-weight: 600;
  color: #1E1E1E;
}

.spec-cost text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E1E1E;
}

/* ========== CUSTOMIZE POP UP ========== */
.customize-pop-up {
  position: fixed;
  width: 750rpx;
  max-height: 90vh;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 38rpx 38rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.customize-pop-up.show {
  transform: translateY(0);
}

.cust-nav-bar {
  padding: 40rpx 35rpx 20rpx;
  background: linear-gradient(180deg, #90CA14 0%, #C8E58A 60%, #FFFFFF 100%);
  border-radius: 38rpx 38rpx 0 0;
  flex-shrink: 0;
}

.cust-title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 50rpx;
  color: #1E1E1E;
  margin-bottom: 10rpx;
}

.cust-subtitle {
  display: block;
  font-size: 21rpx;
  font-weight: 500;
  color: #777777;
  margin-top: 5rpx;
}

.cust-scroll-content {
  padding: 24rpx 28rpx 0;
  background: #FFFFFF;
}

.cust-section {
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.section-hdr {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sect-title {
  font-size: 26rpx;
  font-weight: 600;
}

.manda-tag {
  background: #FFDCDC;
  border: 2rpx dashed #D93B3B;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
  font-size: 17rpx;
  color: #D93B3B;
}

.option-tag {
  background: #FFEACE;
  border: 2rpx dashed #E79119;
  border-radius: 7rpx;
  padding: 4rpx 14rpx;
  font-size: 17rpx;
  color: #E79119;
}

.sect-desc {
  font-size: 21rpx;
  color: #949494;
  margin-bottom: 18rpx;
}

/* ========== FORM ELEMENTS ========== */
.opt-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.opt-item {
  position: relative;
  background: #F7F7F7;
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.opt-item.active {
  background: #FFFFFF;
  box-shadow: 0 0 14rpx rgba(30, 30, 30, 0.2);
}

.side-indicator {
  width: 5rpx;
  height: 56rpx;
  border-radius: 35rpx;
  margin-right: 15rpx;
  background: transparent;
}

.bases .opt-item.active .side-indicator {
  background: linear-gradient(360deg, #D93B3B 0%, #FFDCDC 100%);
}

.bases .opt-item:not(.active) .side-indicator {
  background: linear-gradient(360deg, #90CA14 0%, #EDFFC8 100%);
}

.opt-info { flex: 1; }
.opt-name { display: block; font-size: 21rpx; font-weight: 700; color: #4F4F4F; }
.opt-sub { font-size: 17rpx; color: #838383; }

.radio-butt {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #949494;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-butt.checked { border-color: #90CA14; }

.radio-dot {
  width: 14rpx;
  height: 14rpx;
  background: #456401;
  border-radius: 50%;
}

/* Flat option items (sides & drinks) */
.opt-list-flat {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.opt-item-flat {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 14rpx;
  padding: 18rpx 14rpx;
  transition: all 0.2s ease;
}

.opt-item-flat.active {
  background: #FFFFFF;
  box-shadow: 0 0 14rpx rgba(30, 30, 30, 0.2);
}

.name-rec-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rec-icon {
  width: 21rpx;
  height: 21rpx;
}

.check-box {
  width: 24rpx;
  height: 24rpx;
  border-radius: 2rpx;
  border: 3rpx solid #949494;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.check-box.checked { border-color: #90CA14; }

.check-tick {
  font-size: 16rpx;
  color: #456401;
  font-weight: 700;
  line-height: 1;
}

.bottom-padding-large { height: 40rpx; }

/* ========== CUSTOMIZE FOOTER ========== */
.cust-footer {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 35rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #FFFFFF;
  border-top: 2rpx solid #F0F0F0;
  flex-shrink: 0;
}

.quant-tab {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 17rpx rgba(0, 0, 0, 0.2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.minus-butt, .plus-butt {
  width: 35rpx;
  height: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.minus-text, .plus-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #456401;
  line-height: 1;
}

.quant-val {
  font-size: 42rpx;
  font-weight: 600;
  color: #000000;
  min-width: 28rpx;
  text-align: center;
}

.schedule-butt {
  flex: 2;
  height: 80rpx;
  background: #456401;
  box-shadow: 4rpx 4rpx 35rpx rgba(0, 0, 0, 0.25);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
