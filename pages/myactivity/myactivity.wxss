/* pages/myactivity/myactivity.wxss */

.page-container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
}

.top-shade {
  position: absolute;
  width: 100%;
  height: 200rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 40rpx;
  z-index: 0;
}

.status-bar {
  width: 100%;
  position: relative;
  z-index: 1;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  position: relative;
  z-index: 1;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 24rpx rgba(0, 0, 0, 0.2);
}

.arrow-left {
  font-size: 40rpx;
  font-weight: bold;
  color: #1E1E1E;
  line-height: 1;
}

.page-title {
  font-weight: 600;
  font-size: 40rpx;
  line-height: 40rpx;
  color: #1E1E1E;
  margin-left: 20rpx;
}

.page-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
  position: relative;
  z-index: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-weight: 700;
  font-size: 36rpx;
  line-height: 44rpx;
  color: #1E1E1E;
}

.empty-desc {
  font-weight: 400;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #7A7A7A;
  margin-top: 12rpx;
}

/* ========== Bottom Navigation ========== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  border-top: 2rpx solid #F0F0F0;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-tabs {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 12rpx 0 8rpx;
}

.nav-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 8rpx 0;
}

.nav-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 40rpx;
  color: #A0A0A0;
}

.nav-tab.active .nav-icon {
  color: #456401;
}

.nav-label {
  font-weight: 500;
  font-size: 20rpx;
  line-height: 24rpx;
  color: #A0A0A0;
  margin-top: 4rpx;
}

.nav-tab.active .nav-label {
  color: #456401;
  font-weight: 600;
}

.nav-tab.active {
  border-top: 4rpx solid #456401;
}

.home-indicator {
  display: flex;
  justify-content: center;
  padding-bottom: 16rpx;
  padding-top: 4rpx;
}

.indicator-bar {
  width: 288rpx;
  height: 10rpx;
  background: #000000;
  border-radius: 200rpx;
}
