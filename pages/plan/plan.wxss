page {
  height: 100vh;
  background: #F5F5F5;
}

.page-container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.shade-gradient {
  position: absolute;
  width: 100%;
  height: 200rpx;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, #90CA14 0%, #FFFFFF 100%);
  border-radius: 0 0 80rpx 80rpx;
  z-index: 0;
}

.status-bar {
  width: 100%;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.header {
  display: flex;
  align-items: center;
  padding: 16rpx 40rpx 20rpx;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.page-title {
  font-weight: 700;
  font-size: 36rpx;
  line-height: 44rpx;
  color: #456401;
}

.content-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-title {
  font-weight: 700;
  font-size: 32rpx;
  color: #1E1E1E;
  margin-top: 32rpx;
}

.empty-subtitle {
  font-weight: 500;
  font-size: 24rpx;
  color: #757575;
  margin-top: 12rpx;
  text-align: center;
}

/* Bottom navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  box-shadow: 4rpx 4rpx 40rpx rgba(0, 0, 0, 0.2);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 100;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0 8rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.nav-label {
  font-weight: 700;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #757575;
}

.nav-label.active {
  color: #90CA14;
}

.home-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

.indicator-bar {
  width: 288rpx;
  height: 10rpx;
  background: #000000;
  border-radius: 200rpx;
}
